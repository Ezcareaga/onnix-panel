# =============================================================================
# Onnix SA — Variables de Entorno
# =============================================================================
# Copiar a .env y completar con valores reales
# NUNCA commitear .env a Git
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=onnix
POSTGRES_PASSWORD=CAMBIAR_ESTO
POSTGRES_DB=onnix_prod

# --- InfoCasas Dashboard ---
INFOCASAS_USER=CAMBIAR_ESTO
INFOCASAS_PASS=CAMBIAR_ESTO

# --- Panel Admin ---
PANEL_SECRET_KEY=CAMBIAR_ESTO

# --- Seguridad / Hardening (pre-M7) ---
# ENVIRONMENT=production activa el fail-closed de verificación de firma de
# webhooks (E3): aborta el arranque si falta TWILIO_AUTH_TOKEN.
# En staging/dev usar 'development'
# (docker-compose.dev.yml ya lo overridea).
ENVIRONMENT=production
# Marca `Secure` en las cookies de sesion y de CSRF. Default true — NO tocar
# aca ni en staging: los dos van por HTTPS detras de nginx. Se pone en false
# unicamente para servir por http, o sea la laptop, y eso ya lo hace
# docker-compose.local.yml. Sin `Secure` la cookie viaja en claro; con
# `Secure` sobre http Safari y Firefox la descartan y el login da 403.
# COOKIE_SECURE=true
# Leer la IP real del visitante desde CF-Connecting-IP / X-Forwarded-For (C1).
# Activar SOLO junto con el deploy de nginx realip de Cloudflare; ver
# docs/ops/NGINX_LOGIN_HARDENING.md. Si no, la IP es spoofeable.
TRUST_PROXY_HEADERS=false
# Timeout de inactividad de la sesión del panel en minutos (D2). Default 60.
SESSION_INACTIVITY_MINUTES=60

# --- Anthropic (Claude Haiku) ---
ANTHROPIC_API_KEY=sk-ant-CAMBIAR_ESTO

# --- Telegram Bot (desarrollo) ---

# --- SMTP (reporte diario via Gmail App Password) ---
SMTP_EMAIL=CAMBIAR_ESTO@gmail.com
SMTP_PASSWORD=CAMBIAR_ESTO
REPORT_EMAIL_TO=CAMBIAR_ESTO@email.com

# --- Twilio (WhatsApp) ---
# Las tres las pide `docker-compose.yml:119-121` y NINGUNA estaba en este
# archivo: quien armaba su `.env` desde aca no tenia forma de saber que
# existian. `TWILIO_AUTH_TOKEN` ademas es fail-closed en produccion — sin ella
# el panel no arranca (`panel/app/config.py:119-132`).
TWILIO_ACCOUNT_SID=CAMBIAR_ESTO
TWILIO_AUTH_TOKEN=CAMBIAR_ESTO
# OJO: VA CON EL PREFIJO `whatsapp:`. Un `+595...` pelado no falla — pisa el
# default correcto de `panel/app/bot/config.py:33` y Twilio rechaza **todo**
# mensaje saliente, en silencio. Y si la variable falta en el `.env`, compose
# la inyecta como cadena VACIA, que tampoco deja usar el default.
TWILIO_WHATSAPP_NUMBER=whatsapp:+595900000000

# --- Telegram: el secreto del webhook ---
# Fail-closed junto con TWILIO_AUTH_TOKEN cuando ENVIRONMENT=production
# (`panel/app/config.py:119-132`). El bloque de «Seguridad / Hardening» de
# arriba la nombra desde siempre; faltaba la linea.

# --- Gemini (fallback del bot) ---
# La pide `docker-compose.yml`. **Va vacia a proposito**: el fallback esta
# apagado y tratarla como fatal al boot tumba el panel entero. Vacia, no
# ausente.
GEMINI_API_KEY=

# --- Tests ---
# `panel/tests/conftest.py` la necesita para loguear al admin de prueba. Sin
# ella ~400 tests fallan con 303 y parece que la app esta rota. Es la trampa
# que el CLAUDE.md nombra por su nombre.
TEST_ADMIN_PASSWORD=CAMBIAR_ESTO
