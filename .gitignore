.bash_logout
.bashrc
.profile
.config/
.docker/
.n8n-mcp/
.playwright-mcp/
.pki/

# Scraper runtime data
scrapers/*/failed_items.jsonl

# Node/MCP tooling — SOLO en la raiz. Sin la barra, el patron se aplica en
# cualquier directorio y se llevaba puesto el package.json del proyecto de
# Remotion: un clon fresco no podia instalarlo. Es el mismo tipo de falla que
# la auditoria del 23/08 encontro tres veces en este archivo.
/package-lock.json
/package.json

# `.planning/` NO se ignora. La regla decia «GSD planning tool internal
# state» y quedo de cuando eso era estado de una herramienta; hoy son 427
# documentos de los que 426 ya estaban trackeados, porque un patron nuevo no
# saca del indice lo que ya entro. El unico al que si alcanzo fue
# `CICD_PLAN.md`, creado el 18/08 despues de la regla: `ESTADO_UI.md` manda
# leerlo y en un clon fresco no existia.

# Backup tarball from log reorg
backups/logs_backup_pre_reorg.tar.gz

